# Required
COURTLISTENER_API_TOKEN=...
GITHUB_TOKEN=ghp_...
SEC_EDGAR_USER_AGENT=Your Name your-email@example.com

# Primary LLM provider (Mimo) — preferred for this pipeline
MIMO_API_KEY=tp-...
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Fallback: OpenRouter (optional, for embeddings or other models)
OPENROUTER_API_KEY=sk-or-...

# Optional
FRED_API_KEY=...

# Model routing — defaults to Mimo if MIMO_API_KEY is set
GENERATOR_MODEL=mimo-v2.5-pro
CRITIC_MODEL=mimo-v2.5-pro
SOLVE_RATE_MODELS=mimo-v2.5-pro
EMBED_MODEL=BAAI/bge-small-en-v1.5
